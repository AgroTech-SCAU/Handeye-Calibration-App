# Python bytecode and interpreter caches
__pycache__/
*.py[cod]
*$py.class

# Test, lint and type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Local Python environments
.venv/
venv/
env/
ENV/

# Packaging and PyInstaller output
build/
dist/
*.egg-info/
*.spec
*.manifest

# ROS2 / colcon generated directories
install/
log/

# Local application configuration and calibration results
app_config.json
output/
camera_intrinsics.yaml
samples.yaml
samples_result.yaml

# Local secrets and environment overrides
.env
.env.*
!.env.example

# IDE and editor metadata
.idea/
.vscode/
.vs/
*.code-workspace
*.swp
*.swo
*~

# Operating-system metadata
.DS_Store
Thumbs.db
Desktop.ini

# Runtime logs and temporary files
*.log
*.tmp
*.temp
~$*
